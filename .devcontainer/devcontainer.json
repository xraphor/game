{
  "name": "NUKE PC — Codespaces",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "forwardPorts": [
    3001
  ],
  "portsAttributes": {
    "3001": {
      "label": "NUKE PC desktop",
      "protocol": "https",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "bash start.sh",
  "remoteUser": "codespace"
}
